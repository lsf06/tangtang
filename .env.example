# =====================================================
# 基于边缘 AI 的多模态居家健康监护系统 - 环境变量模板
# =====================================================
# 复制此文件为 .env 并填入实际配置值
# 注意：.env 文件已加入 .gitignore，请勿提交到版本控制！

# -----------------------------------------------------
# 后端服务配置
# -----------------------------------------------------
# Flask 应用环境
FLASK_ENV=production

# Flask 密钥（用于 Session 和 CSRF 保护）
# 生成方法：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# 数据库连接
DATABASE_URL=sqlite:///data/health.db

# Redis 配置（可选）
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------
# API 认证配置
# -----------------------------------------------------
# API Token（用于 API 请求认证）
# 生成方法：python -c "import secrets; print('Bearer ' + secrets.token_hex(32))"
API_TOKEN=your-api-token-here

# -----------------------------------------------------
# 网络配置
# -----------------------------------------------------
# 服务监听地址
HOST=0.0.0.0

# 服务端口
PORT=8080

# 前端 API 地址（用于 Docker 内部通信）
VITE_API_BASE_URL=http://localhost:8080/api

# -----------------------------------------------------
# 第三方服务配置（如需要）
# -----------------------------------------------------
# SMS 服务 API Key（如使用短信通知）
SMS_API_KEY=

# 邮件服务配置
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# 云存储服务（如使用 AWS S3 备份）
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=

# -----------------------------------------------------
# 日志配置
# -----------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# -----------------------------------------------------
# 安全配置
# -----------------------------------------------------
# CORS 允许的来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:8084

# 会话超时时间（秒）
SESSION_TIMEOUT=3600

# 最大请求速率（每分钟请求数）
RATE_LIMIT=100