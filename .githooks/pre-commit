#!/bin/bash
# =====================================================
# Pre-commit 钩子 - 防止敏感信息泄露
# =====================================================

echo "🔒 运行敏感信息扫描..."

# 定义敏感信息模式
PATTERNS=(
    "api[_-]?key\s*[=:]\s*[\"'][a-zA-Z0-9_-]{20,}[\"']"
    "password\s*[=:]\s*[\"'][^\"']{4,}[\"']"
    "secret[_-]?key\s*[=:]\s*[\"'][a-zA-Z0-9_-]{16,}[\"']"
    "token\s*[=:]\s*[\"'][a-zA-Z0-9_-]{20,}[\"']"
    "192\.168\.\d{1,3}\.\d{1,3}"
    "10\.\d{1,3}\.\d{1,3}\.\d{1,3}"
    "172\.(1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3}"
)

# 获取暂存区的文件
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

FOUND_SECRETS=0

for FILE in $STAGED_FILES; do
    # 跳过二进制文件和非代码文件
    if [[ ! "$FILE" =~ \.(js|vue|py|ts|jsx|tsx|java|go|rb|php|yaml|yml|json|conf|env|config)$ ]]; then
        continue
    fi

    # 检查文件是否存在
    if [ ! -f "$FILE" ]; then
        continue
    fi

    # 检查每个模式
    for PATTERN in "${PATTERNS[@]}"; do
        MATCHES=$(grep -n -i -E "$PATTERN" "$FILE" 2>/dev/null)
        if [ -n "$MATCHES" ]; then
            echo "⚠️  在文件 $FILE 中检测到潜在敏感信息："
            echo "$MATCHES"
            echo ""
            FOUND_SECRETS=1
        fi
    done
done

if [ $FOUND_SECRETS -eq 1 ]; then
    echo ""
    echo "❌ 提交被阻止：检测到潜在敏感信息！"
    echo ""
    echo "建议操作："
    echo "1. 检查上述文件，移除硬编码的密钥、密码或内网 IP"
    echo "2. 将敏感信息移至 .env 文件"
    echo "3. 确保 .env 文件已加入 .gitignore"
    echo "4. 如果这是误报，可以使用 'git add --no-skip-worktree' 强制添加"
    echo ""
    exit 1
fi

echo "✅ 敏感信息扫描通过"
exit 0